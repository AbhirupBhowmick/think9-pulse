# Think9 Pulse Backend Environment Variables
APP_ENV=development
PROJECT_NAME="Think9 Pulse API"
API_V1_STR=/api/v1

# Database Configuration
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/think9_pulse

# CORS Settings (comma-separated origins)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Future AI Service Configuration
GEMINI_API_KEY=your_gemini_api_key_here
